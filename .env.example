# Hand Detection Configuration
# Copy this file to .env and update with your settings

# ESP32 Control URL (for sending gesture commands)
# Update this with your ESP32 IP address
CONTROL_URL=http://YOUR_ESP32_IP

# Hand Detection Configuration
# Maximum number of hands to detect (1-2)
MAX_NUM_HANDS=2

# Detection confidence threshold (0.0-1.0)
# Higher = fewer false positives (won't detect face as hand)
# Lower = more sensitive (may detect non-hands)
# Recommended: 0.8 to avoid face detection (including side profiles)
# Note: 0.7 may still detect face when turning head to the side
MIN_DETECTION_CONFIDENCE=0.8

# Tracking confidence threshold (0.0-1.0)
# Used for tracking already-detected hands across frames
# Can be lower than detection confidence
MIN_TRACKING_CONFIDENCE=0.5

# Telemetry Configuration
# Set to True to enable performance monitoring (FPS, RAM, CPU)
TELEMETRY_ENABLED=True

# FPS smoothing factor (0.0-1.0, lower = smoother, higher = more responsive)
TELEMETRY_SMOOTHING=0.1
